# Bluetooth
bluetooth.device.default_name=OnePlus 13
persist.vendor.qcom.bluetooth.aptxadaptiver2_2_support=true

# Laminar
debug.hwui.use_hint_manager=true
debug.sf.enable_adpf_cpu_hint=true

# Device name
ro.product.marketname=OnePlus 13

# ProXDR
ro.vendor.oplus.hdr.uniform=1

# SurfaceFlinger
# QDCM StandardSRGB/DefaultSRGB/EnhanceSRGB -> StandardP3/DefaultP3/EnhanceP3
ro.surface_flinger.wcg_render_intent_map=301:302,303:304,307:308

# Sensors
# ScreenShotRect of the stock fusionlight profile, in 1440x3168 panel pixels
vendor.sensors.als_correction.grabrect=1010 148 1048 190

# USB
vendor.usb.product_string=OnePlus 13

# Vibrator
# LRA period 7692 us (oplus-misc-23821.dtsi) -> ~130 Hz
ro.vendor.vibrator.lra_freq_hz=130
