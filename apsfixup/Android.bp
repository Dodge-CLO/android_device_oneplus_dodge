// Fixes the chroma order of the quick camera bitmap and the front portrait quick
// JPEG. Installs to /odm/lib64 and is
// loaded into com.oplus.camera as a DT_NEEDED of libAlgoProcess.so (added by
// extract-files.py).
cc_library_shared {
    name: "libapsfixup",
    srcs: ["apsfixup.cpp"],
    shared_libs: ["liblog"],
    device_specific: true,
    compile_multilib: "64",
    cflags: [
        "-Wall",
        "-Werror",
    ],
}
